+/* Structural frame: retain safe-area, touch and local-scroll behavior. */
+.dashboard-main{min-width:0;overflow-wrap:anywhere}
+.dashboard-content{width:100%;max-width:1500px;margin-inline:auto;padding:28px 32px 40px}
+.dashboard-main h1{margin:0;font-family:var(--eva-display);font-size:42px;line-height:1.02;letter-spacing:.015em;text-transform:uppercase;color:var(--foreground)}
+.app-navigation{--background:#0b090b;--foreground:#f3ece2;--primary:#f05252;--primary-foreground:#0b090b;--muted:#241214;--muted-foreground:#c5b7b1;--accent:#341518;--accent-foreground:#ff8589;--border:#743338;--ring:#f05252;color:var(--foreground);background:#0b090b;border-right:1px solid var(--border)}
+.app-navigation [data-radix-scroll-area-viewport]{height:100%}
+.eva-sidebar-brand{padding:26px 20px 18px;border-top:3px solid var(--primary)}
+.eva-brand{display:flex;flex-direction:column;gap:8px;min-width:0}
+.eva-brand-register,.eva-brand-caption,.eva-build-label{font:10px/1.5 var(--eva-mono);letter-spacing:.015em;color:var(--muted-foreground)}
+.eva-wordmark{font:700 64px/.85 var(--eva-display);letter-spacing:.025em;color:var(--primary)}
+.eva-brand-caption{font-size:9px}
+.eva-build-label{margin:14px 0 0;font-size:10px}
+.app-navigation nav a{min-height:44px;border-radius:0;border-left:2px solid transparent;font:700 15px/1.2 var(--eva-display);letter-spacing:.055em}
+.app-navigation nav a[aria-current=page]{border-left-color:var(--primary);background:var(--accent);color:var(--primary)}
+.eva-nav-index{margin-left:auto;font:10px/1.2 var(--eva-mono);color:var(--muted-foreground)}
+.eva-mobile-title{font:700 28px/1 var(--eva-display);color:var(--primary);letter-spacing:.08em}
+.eva-workspace-header{position:relative;background:var(--card);min-height:64px;padding:14px 32px;display:flex;align-items:center;gap:20px;border-bottom:1px solid var(--border)}
+.eva-route-marker{border-right:1px solid var(--border);padding-right:20px;display:flex;align-items:center;gap:10px;font:9px/1 var(--eva-mono);color:var(--muted-foreground)}
+.eva-section-id{font:20px/1 var(--eva-mono);color:var(--primary)}
+.eva-route-name{margin:0;font:700 20px/1 var(--eva-display);text-transform:uppercase;letter-spacing:.045em}
+.eva-header-caption{margin-left:auto;font:9px/1.4 var(--eva-mono);color:var(--muted-foreground);text-align:right}
+.eva-panel{position:relative;min-width:0;border:1px solid var(--border);border-radius:0;background:var(--card);color:var(--card-foreground)}
+.eva-panel::before{content:"";position:absolute;left:-1px;top:-1px;width:24px;height:2px;background:var(--primary);pointer-events:none}
+.eva-panel::after{content:"";position:absolute;right:-1px;top:-1px;width:10px;height:10px;background:linear-gradient(45deg,transparent 46%,var(--border) 47%,var(--border) 54%,var(--background) 55%);pointer-events:none}
+[data-ui-button]{border-radius:0;font-family:var(--eva-display);font-size:15px;letter-spacing:.06em;font-weight:700;box-shadow:none;transition:background-color 120ms linear,color 120ms linear,border-color 120ms linear}
+[data-ui-button]:active:not(:disabled){filter:brightness(.85)}
+input,textarea,[role=combobox]{border-radius:0!important}
+.app-dialog{overflow-y:auto;overscroll-behavior:contain;border-radius:0;border-top:3px solid var(--primary)}
+.app-sheet{max-width:100vw;max-height:100dvh;overflow-y:auto;overscroll-behavior:contain;padding-bottom:max(24px,env(safe-area-inset-bottom))}
+.app-sheet.app-navigation .eva-sidebar-brand{padding-top:56px}
+.app-tabs{max-width:100%;overflow-x:auto;justify-content:flex-start;height:auto;min-height:48px;border-radius:0;border-bottom:1px solid var(--border);background:transparent;gap:4px}
+.app-tabs>[role=tab]{flex-shrink:0;min-height:44px;border-radius:0;border-bottom:2px solid transparent;font-family:var(--eva-display);font-size:16px;text-transform:uppercase;letter-spacing:.04em}
+.app-tabs>[role=tab][data-state=active]{border-bottom-color:var(--primary);color:var(--primary);background:var(--accent)}
+.app-table-scroll{max-width:100%;overscroll-behavior-x:contain}
+.app-table-scroll table{min-width:540px}
+.app-table-scroll thead{font:700 14px/1.4 var(--eva-display);text-transform:uppercase;letter-spacing:.04em}
+.app-table-scroll td{font-variant-numeric:tabular-nums}
+/* Command-center: primary traffic instrument, repeated resource rails, event log. */
+.eva-overview{display:flex;flex-direction:column;gap:26px}
+.eva-page-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap}
+.eva-kicker{margin:0 0 8px;font:10px/1.5 var(--eva-mono);letter-spacing:.08em;color:var(--primary)}
+.eva-operator{margin:10px 0 0;font-size:13px;color:var(--muted-foreground)}
+.eva-command-board{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr);gap:20px}
+.eva-panel-label{background:var(--secondary);min-height:45px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;padding:12px 16px;border-bottom:1px solid var(--border);font:10px/1.4 var(--eva-mono);letter-spacing:.035em;color:var(--primary)}
+.eva-panel-label>span:last-child{color:var(--muted-foreground)}
+.eva-panel-label h2{display:flex;align-items:center;gap:10px;margin:0;font:700 17px/1 var(--eva-display);letter-spacing:.06em}
+.eva-panel-label a{display:inline-flex;align-items:center;gap:8px;min-height:28px;text-decoration:none;font-size:10px}
+.eva-instrument-body{position:relative;background-image:linear-gradient(var(--border) 1px,transparent 1px);background-size:100% 100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(160px,220px);align-items:center;gap:16px;padding:32px 24px 24px;min-height:280px}
+.eva-request-readout{min-width:0}
+.eva-hero-number{margin:6px 0 12px;font:400 clamp(48px,6vw,86px)/1.1 var(--eva-mono);letter-spacing:-.07em;color:var(--eva-number);overflow-wrap:anywhere}
+.eva-readout-state{margin:0;font:9px/1.5 var(--eva-mono);letter-spacing:.025em;color:var(--muted-foreground)}
+.eva-radial{position:relative;width:100%;max-width:220px;aspect-ratio:1;margin:auto}
+.eva-radial svg{width:100%;height:100%;fill:none}
+.eva-dial-outer,.eva-dial-tick,.eva-dial-cross{stroke:var(--eva-rule);stroke-width:1}
+.eva-dial-track{stroke:var(--border);stroke-width:8}
+.eva-dial-value{stroke:var(--eva-number);stroke-width:8;transition:stroke-dasharray 180ms linear}
+.eva-radial-copy{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
+.eva-radial-copy>span{font:8px/1.4 var(--eva-mono);color:var(--muted-foreground)}
+.eva-radial-copy strong{font:400 32px/1.2 var(--eva-mono);color:var(--eva-number)}
+.eva-radial-copy small{font-size:14px}
+.eva-instrument-footer{display:flex;align-items:center;gap:12px;padding:10px 16px;border-top:1px solid var(--border);font:8px/1.4 var(--eva-mono);color:var(--muted-foreground)}
+.eva-instrument-footer span:nth-child(2){margin-left:auto}
+.eva-instrument-footer a{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;color:var(--primary)}
+.eva-resource-row{display:grid;grid-template-columns:22px minmax(0,1fr) auto 16px;gap:10px;align-items:center;padding:18px 16px;border-bottom:1px solid var(--border);text-decoration:none;transition:background-color 120ms linear}
+.eva-resource-row:hover{background:var(--accent)}
+.eva-resource-index{font:9px/1.5 var(--eva-mono);color:var(--muted-foreground)}
+.eva-resource-name{display:flex;align-items:center;gap:10px;font:700 18px/1.1 var(--eva-display);text-transform:uppercase;letter-spacing:.03em}
+.eva-resource-name svg{width:16px;height:16px;color:var(--muted-foreground);flex-shrink:0}
+.eva-resource-row strong{font:400 23px/1 var(--eva-mono);color:var(--eva-number)}
+.eva-resource-row>svg{color:var(--muted-foreground)}
+.eva-bank-note{margin:0;padding:18px 16px;font:10px/1.8 var(--eva-mono);color:var(--muted-foreground)}
+.eva-event-log ol{list-style:none;margin:0;padding:0}
+.eva-event-log li{display:grid;grid-template-columns:24px minmax(0,1fr) auto;align-items:baseline;gap:16px;padding:15px 18px;border-bottom:1px solid var(--border)}
+.eva-event-log li:last-child{border-bottom:0}
+.eva-event-index,.eva-event-log time{font:9px/1.5 var(--eva-mono);color:var(--muted-foreground)}
+.eva-event-log li p{margin:0;font-size:13px;overflow-wrap:anywhere}
+.eva-empty-state{padding:28px 18px;margin:0;font:11px/1.5 var(--eva-mono);color:var(--muted-foreground)}
+.eva-user-entry{padding:32px}
+.eva-user-entry h2{font-size:32px;margin:8px 0}
+.eva-user-entry>p:not(.eva-kicker){color:var(--muted-foreground);margin-bottom:24px}
+/* Identity screen: original title-card paired with an explicit action panel. */
+.eva-auth-canvas{background:var(--background)}
+.eva-auth-layout{width:100%;max-width:1100px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,420px);gap:72px;align-items:start}
+.eva-entry{position:relative;min-width:0;padding:28px 24px;border:1px solid var(--border);border-left:3px solid var(--primary)}
+.eva-entry-register{display:flex;justify-content:space-between;gap:12px;padding-bottom:18px;border-bottom:1px solid var(--border);font:9px/1.6 var(--eva-mono);color:var(--muted-foreground)}
+.eva-entry-title{margin:40px 0 24px;font:700 clamp(72px,10vw,132px)/.85 var(--eva-display);letter-spacing:.025em;color:var(--primary)}
+.eva-entry-subtitle{margin:0;font:700 clamp(30px,4vw,48px)/.95 var(--eva-display);letter-spacing:.025em}
+.eva-entry-rule{height:10px;margin:26px 0 20px;width:144px;background:repeating-linear-gradient(120deg,var(--eva-number) 0 6px,transparent 6px 10px)}
+.eva-entry-description{margin:0;max-width:400px;font-size:13px;line-height:1.7;color:var(--muted-foreground)}
+.eva-entry-notice{display:flex;gap:12px;align-items:center;margin:28px 0 0;font:10px/1.5 var(--eva-mono);color:var(--eva-number)}
+.eva-entry-notice span{font-size:14px}
+.eva-auth-form{border-top:3px solid var(--primary);position:relative}.eva-auth-form::after{content:"";position:absolute;bottom:-1px;right:-1px;width:28px;height:3px;background:var(--primary);pointer-events:none}
+.eva-form-title{font:700 28px/1.1 var(--eva-display);text-transform:uppercase;letter-spacing:.025em}
+.eva-auth-form label{font:700 16px/1.2 var(--eva-display);text-transform:uppercase;letter-spacing:.04em}
+.eva-auth-divider{position:relative;display:block;width:fit-content;max-width:100%;margin:-9px auto 0;padding:0 8px;background:var(--card);font-size:11px;line-height:1.5;text-align:center;color:var(--muted-foreground)}
+.eva-auth-compact{width:100%;max-width:520px}
+.eva-auth-compact .eva-entry{padding:24px 24px 8px}
+.eva-auth-compact .eva-entry-title{font-size:76px}
+.eva-auth-compact .eva-entry-subtitle{font-size:30px}
+/* Calibrated frames and repeated arrays: data carries the signal. */
+.eva-workspace-header::after{content:"";position:absolute;bottom:-1px;left:32px;width:64px;height:2px;background:var(--primary);pointer-events:none}
+.eva-instrument-tag{display:inline-block;border:1px solid var(--eva-rule);padding:4px 7px;margin-bottom:22px;color:var(--muted-foreground);font:9px/1.5 var(--eva-mono);letter-spacing:.08em}
+.eva-dial-envelope{stroke:var(--eva-rule);stroke-width:1;stroke-dasharray:2 8}
+.eva-dial-inner{stroke:var(--border);stroke-width:1}
+.eva-dial-bracket{stroke:var(--primary);stroke-width:1}
+.eva-ratio-array{margin:0 24px 24px;padding-top:14px;border-top:1px solid var(--border)}
+.eva-array-legend,.eva-array-scale{display:flex;justify-content:space-between;gap:8px;font:9px/1.5 var(--eva-mono);color:var(--muted-foreground)}
+.eva-array-legend{margin-bottom:10px;color:var(--primary)}
