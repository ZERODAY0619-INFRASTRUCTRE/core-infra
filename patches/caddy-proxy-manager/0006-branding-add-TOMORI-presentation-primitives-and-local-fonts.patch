+.eva-array-slots i{height:24px;border:1px solid var(--eva-rule);background:linear-gradient(to top,var(--eva-number) var(--slot-fill),transparent var(--slot-fill));clip-path:polygon(4px 0,100% 0,100% calc(100% - 4px),calc(100% - 4px) 100%,0 100%,0 4px)}
+.eva-array-scale{margin-top:7px}
