--- /dev/null
+++ b/src/lib/anubis-options.ts
@@ -0,0 +1,22 @@
+export const DEFAULT_ANUBIS_OPTIONS = {
+  algorithm: "fast" as "fast" | "slow" | "metarefresh",
+  difficulty: 4,
+  cookieHours: 24,
+  language: "" as "" | "en" | "ko" | "ja" | "de" | "fr" | "es",
+  simplified: false,
+  robots: false,
+};
+export type AnubisOptions = typeof DEFAULT_ANUBIS_OPTIONS;
+
+/** Shared by the console API and the isolated Anubis supervisor. */
+export function validateAnubisOptions(input: unknown): AnubisOptions {
+  if (!input || typeof input !== "object" || Array.isArray(input)) throw new Error("Expected Anubis options object");
+  const o = input as Record<string, unknown>;
+  if (Object.keys(o).some(key => !Object.hasOwn(DEFAULT_ANUBIS_OPTIONS, key))) throw new Error("Unknown Anubis option");
+  if (!["fast", "slow", "metarefresh"].includes(o.algorithm as string)) throw new Error("Invalid challenge algorithm");
+  if (!Number.isInteger(o.difficulty) || Number(o.difficulty) < 1 || Number(o.difficulty) > 8) throw new Error("Difficulty must be an integer from 1 to 8");
+  if (!Number.isInteger(o.cookieHours) || Number(o.cookieHours) < 1 || Number(o.cookieHours) > 168) throw new Error("Cookie lifetime must be 1 to 168 hours");
+  if (!["", "en", "ko", "ja", "de", "fr", "es"].includes(o.language as string)) throw new Error("Invalid language");
+  if (typeof o.simplified !== "boolean" || typeof o.robots !== "boolean") throw new Error("Explanation and robots options must be booleans");
+  return { algorithm: o.algorithm as AnubisOptions["algorithm"], difficulty: Number(o.difficulty), cookieHours: Number(o.cookieHours), language: o.language as AnubisOptions["language"], simplified: o.simplified, robots: o.robots };
+}
diff --git a/src/lib/anubis-policy.ts b/src/lib/anubis-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ded091f88e0c2a04503bfcc8724eba28cf83111
--- /dev/null
+++ b/src/lib/anubis-policy.ts
@@ -0,0 +1,34 @@
+import type { AnubisOptions } from "./anubis-options";
+import { hostMatchesPattern } from "./host-pattern-priority";
+
+export type AnubisHostPolicy = { domains: string[]; enabled: boolean; anubisEnabled?: boolean };
+export type AnubisStatus = { available: boolean; enabled: boolean; domain: string | null; options?: AnubisOptions; configurable?: boolean };
+
+export function inAnubisScope(domain: string, scope: string): boolean {
+  return hostMatchesPattern(domain, `*.${scope}`);
+}
+
+/** Exact hosts override wildcard hosts, as they do in Caddy route ordering.
+ * Conflicting duplicate names remain protected if either host enables protection.
+ * Unmanaged names retain the deployment's original wildcard protection.
+ */
+export function anubisExpression(scope: string, hosts: AnubisHostPolicy[]): string {
+  const pattern = `^[^.]+[.]${scope.replaceAll(".", "[.]")}[.]?$`;
+  const base = `{http.request.host}.lowerAscii().matches(${JSON.stringify(pattern)})`;
+  const choices = new Map<string, boolean>();
+  for (const host of hosts) {
+    if (!host.enabled) continue;
+    for (const value of host.domains) {
+      const domain = value.trim().toLowerCase().replace(/\.$/, "");
+      if (!inAnubisScope(domain, scope)) continue;
+      choices.set(domain, (choices.get(domain) ?? false) || host.anubisEnabled !== false);
+    }
+  }
+  const wildcardEnabled = choices.get(`*.${scope}`) !== false;
+  const exact = [...choices].filter(([domain, enabled]) => !domain.startsWith("*.") && enabled !== wildcardEnabled);
+  if (!exact.length) return wildcardEnabled ? base : "false";
+  // Compare literal hostnames through a CEL list; no user value becomes code.
+  const names = exact.flatMap(([domain]) => [domain, domain + "."]);
+  const match = `{http.request.host}.lowerAscii() in ${JSON.stringify(names)}`;
+  return `(${base}) && (${wildcardEnabled ? `!(${match})` : match})`;
+}
diff --git a/src/lib/anubis-runtime.ts b/src/lib/anubis-runtime.ts
