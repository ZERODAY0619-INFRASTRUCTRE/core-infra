+export function escapeHtml(value: unknown): string { return String(value ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!)); }
+const icon=(name:string)=>`<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">${name==='browser'?'<rect x="4" y="6" width="32" height="23" rx="3"/><path d="M13 35h14M20 29v6M4 13h32"/>':name==='proxy'?'<path d="M11 30a8 8 0 0 1-1-16 11 11 0 0 1 21-1 9 9 0 0 1-1 17Z"/>':'<rect x="7" y="4" width="26" height="13" rx="3"/><rect x="7" y="23" width="26" height="13" rx="3"/><path d="M12 10h2m4 0h10M12 29h2m4 0h10"/>'}</svg>`;
+export function statusMarkup(code:string, details:StatusDetails={}, maintenance=false):string {
+  const n=Number(code), entry=errorCatalog[n]??errorCatalog[n<500?400:500];
+  const title=maintenance?statusMessages.maintenance.title:entry.title;
+  const source=details.source??'app';
+  const host=details.host||'Host unavailable';
+  const origin=maintenance?'Not checked':n===404?'Resource not found':source==='proxy'&&n>=500?'Connection or response error':source==='app'&&n>=500?'Application error':'Unavailable';
+  const node=(name:string,label:string,sub:string,state:string,tone:string)=>`<section class="status-node">${icon(name)}<h3>${label}</h3><p>${escapeHtml(sub)}</p><span class="status-badge status-${tone}">${state}</span></section>`;
+  return `<main lang="en" class="status-page" data-status-code="${escapeHtml(code)}" aria-labelledby="status-title"><style>${statusStyles}</style><a class="status-skip" href="#status-title">Skip to content</a><div class="status-wrap"><header class="status-brand"><span class="status-wordmark">${escapeHtml(APP_NAME)}</span><span class="status-brand-subtitle" lang="en">REQUEST DIAGNOSTICS</span><span class="status-full-name">${escapeHtml(APP_FULL_NAME)}</span></header><div class="status-header"><p class="status-code"><span class="status-protocol">${maintenance?'MAINTENANCE / ':''}HTTP STATUS</span><span class="status-designation">${escapeHtml(code)}</span></p><h2 id="status-title" tabindex="-1">${escapeHtml(title)}</h2><p class="status-message">${escapeHtml(maintenance?statusMessages.maintenance.message:entry.reason)}</p><time class="status-time">${escapeHtml(details.timeLabel||'Event time (UTC)')}: <span data-meta="timestamp">${escapeHtml(details.timestamp||'Unavailable')}</span></time></div><div class="status-chain" aria-label="Request processing status">${node('browser','Browser','Client request','Request received','ok')}${node('proxy','Proxy',source==='proxy'?(details.proxyLabel||'Proxy handling this request'):'Proxy diagnostics unavailable',maintenance&&source==='proxy'?'Under maintenance':source==='proxy'?'Response generated':'Unavailable',source==='proxy'&&!maintenance?'ok':'unknown')}${node('server','Origin server',host,origin,maintenance?'unknown':n>=500||n===404?'error':'unknown')}</div><p class="status-note">These states describe this request. They are not live health checks of the entire browser or network.</p><section class="status-explainer"><div><h3>What happened?</h3><p>${escapeHtml(maintenance?'The operator enabled maintenance mode and temporarily paused request processing.':entry.reason)}</p><details class="status-owner"><summary>For site operators</summary><p>${escapeHtml(maintenance?'After maintenance, disable MAINTENANCE_MODE and confirm the proxy configuration has been applied.':entry.owner)}</p></details></div><div><h3>What can I do?</h3><p>${escapeHtml(maintenance?'Try again later.':entry.visitor)}</p><div class="status-actions"><button type="button" class="status-action" data-action="retry">Retry</button><a class="status-action status-secondary" href="/">Home</a><button type="button" class="status-action status-secondary" data-action="copy">Copy diagnostics</button></div><p class="status-notice" data-copy-status role="status" aria-live="polite"></p><textarea class="status-copybox" data-copybox aria-label="Diagnostics to copy" readonly hidden></textarea></div></section><footer class="status-footer"><div class="status-meta"><p>${escapeHtml(details.idLabel||'Request ID')}: <code data-meta="requestId">${escapeHtml(details.requestId||'Unavailable')}</code></p><p>Request host: <span data-meta="host">${escapeHtml(host)}</span></p><p hidden>Request path: <span data-meta="path">${escapeHtml(details.path||'/')}</span></p><details class="status-ip"><summary>Show my IP address</summary><code data-meta="clientIp">${escapeHtml(details.clientIp||'Unavailable')}</code></details>${details.digest?`<p>Error reference: <code data-meta="digest">${escapeHtml(details.digest)}</code></p>`:''}</div><div class="status-feedback"><span>Was this page helpful?</span><button type="button" class="status-action status-secondary" data-vote="yes">Yes</button><button type="button" class="status-action status-secondary" data-vote="no">No</button></div><p class="status-notice" data-feedback-status role="status" aria-live="polite"></p><noscript><p>Expand the IP section to view your address. Refresh the browser to retry. Copy and feedback require JavaScript.</p></noscript><p class="status-note">Copied diagnostics exclude your IP address and URL query. Feedback sends only the request ID, error code, and your answer.</p></footer></div></main>`;
+}
+/** All dependencies are local so the same function can be shipped as a CSP-hashed inline script. */
+export function bindStatusPage(root:HTMLElement|null, reset?:()=>void):()=>void {
+  if(!root)return ()=>{};
+  const click=async(event:Event)=>{
+    const button=(event.target as Element).closest<HTMLButtonElement>('button');
+    if(!button||!root.contains(button))return;
+    const meta=(name:string)=>root.querySelector(`[data-meta="${name}"]`)?.textContent||'';
+    if(button.dataset.action==='retry'){if(reset)reset();else window.location.reload();return;}
+    if(button.dataset.action==='copy'){
+      const text=[`HTTP ${root.dataset.statusCode}`,`Request ID: ${meta('requestId')}`,`UTC: ${meta('timestamp')}`,`Host: ${meta('host')}`,`Path: ${meta('path')}`,meta('digest')?`Error reference: ${meta('digest')}`:''].filter(Boolean).join('\n');
+      const notice=root.querySelector<HTMLElement>('[data-copy-status]')!;
+      try{await navigator.clipboard.writeText(text);notice.textContent='Diagnostics copied.';}
+      catch{const box=root.querySelector<HTMLTextAreaElement>('[data-copybox]')!;box.hidden=false;box.value=text;box.focus();box.select();notice.textContent='Automatic copying is unavailable. Copy the selected text manually.';}
+    }
+    if(button.dataset.vote){
+      const notice=root.querySelector<HTMLElement>('[data-feedback-status]')!;
+      const buttons=root.querySelectorAll<HTMLButtonElement>('[data-vote]');
+      buttons.forEach(b=>b.disabled=true);
+      try{
+        const requestId=meta('requestId');
+        if(!/^[0-9a-f-]{36}$/i.test(requestId))throw new Error('unavailable');
+        const r=await fetch('/api/error-feedback',{method:'POST',credentials:'omit',headers:{'Content-Type':'application/json'},body:JSON.stringify({requestId,code:Number(root.dataset.statusCode),helpful:button.dataset.vote==='yes'}),signal:AbortSignal.timeout(8000)});
+        if(!r.ok)throw new Error('unavailable');
+        notice.textContent='Feedback saved. Thank you.';
+      }catch{notice.textContent='Feedback could not be saved. Please try again later.';buttons.forEach(b=>b.disabled=false);}
+    }
+  };
+  root.addEventListener('click',click);return ()=>root.removeEventListener('click',click);
+}
+export const statusScript=`(${bindStatusPage.toString()})(document.querySelector('.status-page'));`;
+export function statusHtml(kind:keyof typeof statusMessages, code?:string, details:StatusDetails={}):string {
+  const value=code??statusMessages[kind].code;
+  const title=kind==='maintenance'?statusMessages.maintenance.title:(errorCatalog[Number(value)]??errorCatalog[Number(value)<500?400:500]).title;
+  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>${escapeHtml(title)} | ${escapeHtml(APP_NAME)}</title></head><body style="margin:0">${statusMarkup(value,details,kind==='maintenance')}<script>${statusScript}</script></body></html>`;
+}
+export function maintenanceEnabled(value=process.env.MAINTENANCE_MODE):boolean{return value==='1'||value?.toLowerCase()==='true';}
+export const statusHeaders={'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-store','X-Content-Type-Options':'nosniff','X-Frame-Options':'DENY','Referrer-Policy':'no-referrer'};
+export function upstreamErrorResponses(){return [{match:{status_code:[4,5],headers:{'Content-Type':['text/html*']}},routes:[{handle:[{handler:'error',status_code:'{http.reverse_proxy.status_code}',error:'Upstream request failed'}]}]}];}
