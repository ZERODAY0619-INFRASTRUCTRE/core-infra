+describe("Anubis runtime option contract", () => {
+  it("accepts the deployed defaults and bounded form settings", () => {
+    expect(validateAnubisOptions(DEFAULT_ANUBIS_OPTIONS)).toEqual(DEFAULT_ANUBIS_OPTIONS);
