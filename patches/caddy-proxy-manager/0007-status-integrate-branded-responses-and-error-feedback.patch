+/** All dependencies are local so the same function can be shipped as a CSP-hashed inline script. */
+export function bindStatusPage(root:HTMLElement|null, reset?:()=>void):()=>void {
+  if(!root)return ()=>{};
+  const click=async(event:Event)=>{
+    const button=(event.target as Element).closest<HTMLButtonElement>('button');
+    if(!button||!root.contains(button))return;
+    const meta=(name:string)=>root.querySelector(`[data-meta="${name}"]`)?.textContent||'';
+    if(button.dataset.action==='retry'){if(reset)reset();else window.location.reload();return;}
+    if(button.dataset.action==='copy'){
+      const text=[`HTTP ${root.dataset.statusCode}`,`Request ID: ${meta('requestId')}`,`UTC: ${meta('timestamp')}`,`Host: ${meta('host')}`,`Path: ${meta('path')}`,meta('digest')?`Error reference: ${meta('digest')}`:''].filter(Boolean).join('\n');
+      const notice=root.querySelector<HTMLElement>('[data-copy-status]')!;
+      try{await navigator.clipboard.writeText(text);notice.textContent='Diagnostics copied.';}
+      catch{const box=root.querySelector<HTMLTextAreaElement>('[data-copybox]')!;box.hidden=false;box.value=text;box.focus();box.select();notice.textContent='Automatic copying is unavailable. Copy the selected text manually.';}
+    }
+    if(button.dataset.vote){
+      const notice=root.querySelector<HTMLElement>('[data-feedback-status]')!;
+      const buttons=root.querySelectorAll<HTMLButtonElement>('[data-vote]');
+      buttons.forEach(b=>b.disabled=true);
+      try{
+        const requestId=meta('requestId');
+        if(!/^[0-9a-f-]{36}$/i.test(requestId))throw new Error('unavailable');
+        const r=await fetch('/api/error-feedback',{method:'POST',credentials:'omit',headers:{'Content-Type':'application/json'},body:JSON.stringify({requestId,code:Number(root.dataset.statusCode),helpful:button.dataset.vote==='yes'}),signal:AbortSignal.timeout(8000)});
+        if(!r.ok)throw new Error('unavailable');
+        notice.textContent='Feedback saved. Thank you.';
+      }catch{notice.textContent='Feedback could not be saved. Please try again later.';buttons.forEach(b=>b.disabled=false);}
+    }
+  };
+  root.addEventListener('click',click);return ()=>root.removeEventListener('click',click);
+}
+export const statusScript=`(${bindStatusPage.toString()})(document.querySelector('.status-page'));`;
+export function statusHtml(kind:keyof typeof statusMessages, code?:string, details:StatusDetails={}):string {
+  const value=code??statusMessages[kind].code;
+  const title=kind==='maintenance'?statusMessages.maintenance.title:(errorCatalog[Number(value)]??errorCatalog[Number(value)<500?400:500]).title;
+  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>${escapeHtml(title)} | ${escapeHtml(APP_NAME)}</title></head><body style="margin:0">${statusMarkup(value,details,kind==='maintenance')}<script>${statusScript}</script></body></html>`;
+}
+export function maintenanceEnabled(value=process.env.MAINTENANCE_MODE):boolean{return value==='1'||value?.toLowerCase()==='true';}
+export const statusHeaders={'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-store','X-Content-Type-Options':'nosniff','X-Frame-Options':'DENY','Referrer-Policy':'no-referrer'};
+export function upstreamErrorResponses(){return [{match:{status_code:[4,5],headers:{'Content-Type':['text/html*']}},routes:[{handle:[{handler:'error',status_code:'{http.reverse_proxy.status_code}',error:'Upstream request failed'}]}]}];}
