+  return `<main lang="en" class="status-page" data-status-code="${escapeHtml(code)}" aria-labelledby="status-title"><style>${statusStyles}</style><a class="status-skip" href="#status-title">Skip to content</a><div class="status-wrap"><header class="status-brand"><span class="status-wordmark">${escapeHtml(APP_NAME)}</span><span class="status-brand-subtitle" lang="en">REQUEST DIAGNOSTICS</span><span class="status-full-name">${escapeHtml(APP_FULL_NAME)}</span></header><div class="status-header"><p class="status-code"><span class="status-protocol">${maintenance?'MAINTENANCE / ':''}HTTP STATUS</span><span class="status-designation">${escapeHtml(code)}</span></p><h2 id="status-title" tabindex="-1">${escapeHtml(title)}</h2><p class="status-message">${escapeHtml(maintenance?statusMessages.maintenance.message:entry.reason)}</p><time class="status-time">${escapeHtml(details.timeLabel||'Event time (UTC)')}: <span data-meta="timestamp">${escapeHtml(details.timestamp||'Unavailable')}</span></time></div><div class="status-chain" aria-label="Request processing status">${node('browser','Browser','Client request','Request received','ok')}${node('proxy','Proxy',source==='proxy'?(details.proxyLabel||'Proxy handling this request'):'Proxy diagnostics unavailable',maintenance&&source==='proxy'?'Under maintenance':source==='proxy'?'Response generated':'Unavailable',source==='proxy'&&!maintenance?'ok':'unknown')}${node('server','Origin server',host,origin,maintenance?'unknown':n>=500||n===404?'error':'unknown')}</div><p class="status-note">These states describe this request. They are not live health checks of the entire browser or network.</p><section class="status-explainer"><div><h3>What happened?</h3><p>${escapeHtml(maintenance?'The operator enabled maintenance mode and temporarily paused request processing.':entry.reason)}</p><details class="status-owner"><summary>For site operators</summary><p>${escapeHtml(maintenance?'After maintenance, disable MAINTENANCE_MODE and confirm the proxy configuration has been applied.':entry.owner)}</p></details></div><div><h3>What can I do?</h3><p>${escapeHtml(maintenance?'Try again later.':entry.visitor)}</p><div class="status-actions"><button type="button" class="status-action" data-action="retry">Retry</button><a class="status-action status-secondary" href="/">Home</a><button type="button" class="status-action status-secondary" data-action="copy">Copy diagnostics</button></div><p class="status-notice" data-copy-status role="status" aria-live="polite"></p><textarea class="status-copybox" data-copybox aria-label="Diagnostics to copy" readonly hidden></textarea></div></section><footer class="status-footer"><div class="status-meta"><p>${escapeHtml(details.idLabel||'Request ID')}: <code data-meta="requestId">${escapeHtml(details.requestId||'Unavailable')}</code></p><p>Request host: <span data-meta="host">${escapeHtml(host)}</span></p><p hidden>Request path: <span data-meta="path">${escapeHtml(details.path||'/')}</span></p><details class="status-ip"><summary>Show my IP address</summary><code data-meta="clientIp">${escapeHtml(details.clientIp||'Unavailable')}</code></details>${details.digest?`<p>Error reference: <code data-meta="digest">${escapeHtml(details.digest)}</code></p>`:''}</div><div class="status-feedback"><span>Was this page helpful?</span><button type="button" class="status-action status-secondary" data-vote="yes">Yes</button><button type="button" class="status-action status-secondary" data-vote="no">No</button></div><p class="status-notice" data-feedback-status role="status" aria-live="polite"></p><noscript><p>Expand the IP section to view your address. Refresh the browser to retry. Copy and feedback require JavaScript.</p></noscript><p class="status-note">Copied diagnostics exclude your IP address and URL query. Feedback sends only the request ID, error code, and your answer.</p></footer></div></main>`;
