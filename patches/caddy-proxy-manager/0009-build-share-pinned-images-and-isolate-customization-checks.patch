@@ -0,0 +1,77 @@
+name: Refresh Caddy compatibility pins
+
+on:
+  schedule:
+    - cron: "17 5 * * 1"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pull-requests: write
+
+jobs:
+  update:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v7
+
+      - name: Set up Go
+        uses: actions/setup-go@v7
+        with:
+          go-version-file: docker/caddy/go.mod
+
+      - name: Refresh Caddy compatibility replacement
+        run: sh docker/caddy/update-compatibility-pins.sh
+
+      - name: Detect changes
+        id: changes
+        run: |
+          if git diff --quiet -- docker/caddy/go.mod docker/caddy/go.sum; then
+            echo "changed=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "changed=true" >> "$GITHUB_OUTPUT"
+          fi
+
+      # Build the Caddy Dockerfile directly instead of `docker compose build caddy`:
+      # Compose interpolates variables for ALL services before building, and
+      # docker-compose.yml declares hard-required vars (SESSION_SECRET,
+      # ADMIN_USERNAME, ADMIN_PASSWORD, CLICKHOUSE_PASSWORD) that are unset in
+      # CI, so compose always failed here regardless of the caddy service. The
+      # Dockerfile re-runs update-compatibility-pins.sh inside the build, so
+      # this still end-to-end verifies the refreshed pins. Mirrors the caddy
+      # job of docker-build-pr.yml (same Dockerfile, same GHA cache scope).
+      - name: Set up Docker Buildx
+        if: steps.changes.outputs.changed == 'true'
+        uses: docker/setup-buildx-action@v4
+
+      - name: Verify updated Caddy image
+        if: steps.changes.outputs.changed == 'true'
+        uses: docker/build-push-action@v7
+        with:
+          context: .
+          file: docker/caddy/Dockerfile
+          push: false
+          platforms: linux/amd64
+          cache-from: type=gha,scope=caddy
+
+      - name: Open compatibility-pin pull request
+        if: steps.changes.outputs.changed == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          BASE_BRANCH: ${{ github.event.repository.default_branch }}
+        run: |
+          branch="automation/caddy-compatibility-pins"
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git switch -C "$branch"
+          git add docker/caddy/go.mod docker/caddy/go.sum
+          git commit -m "caddy: refresh compatibility pins"
+          git push --force origin "$branch"
+          if ! gh pr list --head "$branch" --state open --json number --jq '.[0].number' | grep -q '[0-9]'; then
+            gh pr create \
+              --base "$BASE_BRANCH" \
+              --head "$branch" \
+              --title "caddy: refresh compatibility pins" \
+              --body "Automated compatibility-pin refresh derived from the pinned Caddy module. The Caddy image build passed before this PR was opened."
+          fi
