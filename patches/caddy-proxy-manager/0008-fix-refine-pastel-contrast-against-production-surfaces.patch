 src/components/ui/SegmentedControl.tsx   |  2 +-
 src/components/ui/chart-internals.tsx    | 10 ++++++----
 tests/unit/ui-charts.test.ts             | 15 +++++++++++++++
 tests/unit/ui-components.test.ts         |  2 +-
 7 files changed, 30 insertions(+), 11 deletions(-)

