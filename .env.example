# 이 파일을 .env로 복사한 뒤 실제 환경에 맞게 수정하세요.
# .env는 Git에서 제외됩니다. 파일 권한은 chmod 600 .env로 제한하세요.
# 기존 운영 볼륨을 연결하기 전 docs/MIGRATION.ko.md를 확인하세요.

# Compose 프로젝트와 공통 이미지
# 운영 전환 시 기존 프로젝트 이름과 빌드한 이미지 태그를 입력하세요.
COMPOSE_PROJECT_NAME=cpm-preview
CPM_WEB_IMAGE=cpm-web:preview
CPM_CADDY_IMAGE=cpm-caddy:preview
# 선택 기능: clickhouse / geoipupdate / clickhouse,geoipupdate
# 모두 사용하지 않으면 빈 값으로 두세요.
COMPOSE_PROFILES=clickhouse

# 두 관리 UI의 실제 접속 URL (OAuth 콜백에도 사용)
ICPM_BASE_URL=http://cpm-tailnet:3000
PCPM_BASE_URL=http://cpm-tailnet:3001

# ClickHouse 사용 시 필수: 충분히 긴 비밀번호를 입력하세요.
CLICKHOUSE_PASSWORD=
# 점검 모드: 0=해제, 1=활성화
MAINTENANCE_MODE=0

# 아래 주소는 예제입니다. 배포 전에 실제 서버 주소로 교체하세요.
# 주소·호스트·포트에는 리터럴만 사용하세요. 변수 확장이나 같은 줄 주석은 금지합니다.
# 공개 HTTP/HTTPS를 바인딩할 서버 IPv4 (0.0.0.0은 허용하지 않음)
PUBLIC_BIND_IP=192.0.2.10
# 호스트 자체로의 프록시 우회를 차단할 Tailnet IPv4
HOST_TAILNET_IP=100.64.0.10

# 소문자 DNS 이름만 입력하세요. SSO_HOST는 보호 도메인 하위여야 합니다.
# Authentik provider slug는 icpm과 pcpm을 사용합니다.
SSO_HOST=sso.proxy.example.com
ANUBIS_PROTECTED_DOMAIN=proxy.example.com

# Authentik outpost HTTPS backend의 IPv4와 포트
AUTHENTIK_UPSTREAM_IP=100.64.0.20
AUTHENTIK_UPSTREAM_PORT=10443
# 기본값은 인증서 검증 활성화. 자체 서명 backend를 허용할 때만 true로 변경하세요.
AUTHENTIK_TLS_INSECURE=false

# 내부 ICPM 웹: SESSION_SECRET은 32자 이상, 외부 PCPM과 다른 값 사용
ICPM_SESSION_SECRET=
ICPM_ADMIN_USERNAME=admin
ICPM_ADMIN_PASSWORD=
ICPM_OAUTH_CLIENT_ID=
ICPM_OAUTH_CLIENT_SECRET=

# 외부 PCPM 웹: 기존 배포 이전 시 기존 비밀값을 그대로 입력
PCPM_SESSION_SECRET=
PCPM_ADMIN_USERNAME=admin
PCPM_ADMIN_PASSWORD=
PCPM_OAUTH_CLIENT_ID=
PCPM_OAUTH_CLIENT_SECRET=

# Tailscale 최초 인증 키 (기존 인증 상태를 이전하면 생략 가능)
TS_AUTHKEY=
# Anubis 서명 키: 64자리 16진수
ANUBIS_PRIVATE_KEY_HEX=

# GeoIP 자동 갱신 프로파일 사용 시 입력
ICPM_GEOIPUPDATE_ACCOUNT_ID=
ICPM_GEOIPUPDATE_LICENSE_KEY=
PCPM_GEOIPUPDATE_ACCOUNT_ID=
PCPM_GEOIPUPDATE_LICENSE_KEY=
