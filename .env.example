# Review docs/MIGRATION.ko.md before using existing production volumes.
COMPOSE_PROJECT_NAME=cpm-preview
CPM_WEB_IMAGE=cpm-web:preview
CPM_CADDY_IMAGE=cpm-caddy:preview
COMPOSE_PROFILES=clickhouse
ICPM_BASE_URL=http://cpm-tailnet:3000
PCPM_BASE_URL=http://cpm-tailnet:3001
CLICKHOUSE_PASSWORD=
MAINTENANCE_MODE=0

# Site settings: literal IPv4/hostnames, no variable expansion.
# Documentation addresses must be replaced before deployment.
PUBLIC_BIND_IP=192.0.2.10
HOST_TAILNET_IP=100.64.0.10
SSO_HOST=sso.proxy.example.com
ANUBIS_PROTECTED_DOMAIN=proxy.example.com
AUTHENTIK_UPSTREAM_IP=100.64.0.20
AUTHENTIK_UPSTREAM_PORT=10443
AUTHENTIK_TLS_INSECURE=false
