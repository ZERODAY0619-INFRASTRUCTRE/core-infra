  "tailscale": {
    "network_mode": "service:tailscale-net",
    "cap_add": [
      "NET_ADMIN",
      "NET_RAW"
    ],
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "restart": "no",
    "depends_on": {
      "tailscale-net": {
        "condition": "service_healthy",
        "required": true
      }
    },
    "devices": [
      {
        "source": "/dev/net/tun",
        "target": "/dev/net/tun",
        "permissions": "rwm"
      }
    ],
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "tailscale status --json | grep -q '\"BackendState\": \"Running\"'"
      ],
      "timeout": "3s",
      "interval": "5s",
      "retries": 24,
      "start_period": "15s"
    },
    "volumes": [
      {
        "type": "volume",
        "target": "/var/lib/tailscale",
        "source": "tailscale-state"
      }
    ]
  },
  "tailscale-net": {
    "networks": {
      "icpm": {
        "ipv4_address": "172.30.80.4"
      },
      "pcpm": {
        "ipv4_address": "172.30.81.4"
      },
      "transport": {
        "gw_priority": 1
      }
    },
    "cap_add": [
      "NET_ADMIN"
    ],
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "read_only": true,
    "restart": "no",
    "sysctls": {
      "net.ipv4.conf.all.rp_filter": "0",
      "net.ipv4.conf.default.rp_filter": "0",
      "net.ipv4.ip_forward": "1",
      "net.ipv6.conf.all.disable_ipv6": "0"
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "test -f /tmp/cpm-ready && nft list table inet cpm >/dev/null"
      ],
      "timeout": "3s",
      "interval": "5s",
      "retries": 5
