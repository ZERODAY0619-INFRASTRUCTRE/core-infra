        "bun",
        "-e",
        "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      ],
      "timeout": "5s",
      "interval": "15s",
      "retries": 6,
      "start_period": "40s"
    },
    "volumes": [
      {
        "type": "volume",
        "target": "/app/data",
        "source": "icpm-manager-data"
      },
      {
        "type": "bind",
        "target": "/run/cpm-observations",
        "read_only": true
      },
      {
        "type": "volume",
        "target": "/logs",
        "source": "icpm-logs"
      },
      {
        "type": "volume",
        "target": "/usr/share/GeoIP",
        "read_only": true,
        "source": "icpm-geoip"
      },
      {
        "type": "volume",
        "target": "/acme-ca",
        "source": "icpm-acme"
      }
    ]
  },
