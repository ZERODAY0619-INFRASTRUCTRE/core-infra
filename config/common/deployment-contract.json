{
  "icpm-caddy": {
    "network_mode": "service:icpm-caddy-net",
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "restart": "no",
    "depends_on": {
      "icpm-caddy-net": {
        "condition": "service_healthy",
        "required": true
      }
    },
    "healthcheck": {
      "test": [
        "CMD",
        "wget",
        "--quiet",
        "--tries=1",
        "-O",
        "/dev/null",
        "http://localhost:2019/config/"
      ],
      "timeout": "5s",
      "interval": "10s",
      "retries": 6,
      "start_period": "15s"
    },
    "volumes": [
      {
        "type": "volume",
        "target": "/data",
        "source": "icpm-caddy-data"
      },
      {
        "type": "volume",
        "target": "/config",
        "source": "icpm-caddy-config"
      },
      {
        "type": "volume",
        "target": "/logs",
        "source": "icpm-logs"
      },
      {
        "type": "volume",
        "target": "/usr/share/GeoIP",
        "read_only": true,
        "source": "icpm-geoip"
      },
      {
        "type": "volume",
        "target": "/acme-ca",
        "read_only": true,
        "source": "icpm-acme"
      },
      {
        "type": "bind",
        "target": "/etc/caddy/Caddyfile",
        "read_only": true
      }
    ]
  },
  "icpm-caddy-net": {
    "networks": {
      "icpm": {
        "ipv4_address": "172.30.80.2"
      }
    },
    "cap_add": [
      "NET_ADMIN"
    ],
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "read_only": true,
    "restart": "no",
    "depends_on": {
      "tailscale": {
        "condition": "service_healthy",
        "required": true
      }
    },
    "sysctls": {
      "net.ipv4.ip_unprivileged_port_start": "0",
      "net.ipv6.conf.all.disable_ipv6": "1"
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "test -f /tmp/cpm-ready && nft list table inet cpm >/dev/null"
      ],
      "timeout": "3s",
      "interval": "5s",
      "retries": 5
    },
    "volumes": [
      {
        "type": "bind",
        "target": "/etc/cpm/rules.nft",
        "read_only": true
      },
      {
        "type": "bind",
        "target": "/etc/cpm/policy",
        "read_only": true
      }
    ]
  },
  "icpm-clickhouse": {
    "network_mode": "service:icpm-web-net",
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "restart": "no",
    "depends_on": {
      "icpm-web-net": {
        "condition": "service_healthy",
        "required": true
      }
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "clickhouse-client --host 127.0.0.1 --user cpm --password \"$$CLICKHOUSE_PASSWORD\" --query \"SELECT 1\""
      ],
      "timeout": "5s",
      "interval": "10s",
      "retries": 12,
      "start_period": "30s"
    },
    "profiles": [
      "clickhouse"
    ],
    "volumes": [
      {
        "type": "volume",
        "target": "/var/lib/clickhouse",
        "source": "icpm-clickhouse-data"
      },
      {
        "type": "volume",
        "target": "/var/log/clickhouse-server",
        "source": "icpm-clickhouse-logs"
      },
      {
        "type": "bind",
        "target": "/etc/clickhouse-server/config.d/low-disk-write.xml",
        "read_only": true
      },
      {
        "type": "bind",
        "target": "/etc/clickhouse-server/config.d/zz-local.xml",
        "read_only": true
      }
    ]
  },
  "icpm-geoipupdate": {
    "networks": {
      "geoip-egress": null
    },
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "read_only": true,
    "restart": "no",
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "test -s /usr/share/GeoIP/GeoLite2-Country.mmdb && test -s /usr/share/GeoIP/GeoLite2-ASN.mmdb"
      ],
      "timeout": "3s",
      "interval": "10s",
      "retries": 18,
      "start_period": "30s"
    },
    "profiles": [
      "geoipupdate"
    ],
    "volumes": [
      {
        "type": "volume",
        "target": "/usr/share/GeoIP",
        "source": "icpm-geoip"
      }
    ]
  },
  "icpm-web": {
    "network_mode": "service:icpm-web-net",
    "cap_drop": [
      "ALL"
    ],
