{
    admin off
    auto_https off
}

# Private relay in PCPM's network namespace. Only outpost protocol requests
# reach the existing SSO backend; no public listener or browser challenge.
:8927 {
    bind 127.0.0.1
    handle /outpost.goauthentik.io/* {
        reverse_proxy https://@@AUTHENTIK_UPSTREAM_IP@@:@@AUTHENTIK_UPSTREAM_PORT@@ {
            # Preserve the protected application's identity for single-app auth.
            header_up Host {http.request.host}
            trusted_proxies 127.0.0.1/32
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
                # Verification is enabled unless explicitly disabled in local site settings.
                @@AUTHENTIK_TLS_DIRECTIVE@@
            }
        }
    }
    respond 404
}
