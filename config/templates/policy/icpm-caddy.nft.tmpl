table inet cpm {
    # Refreshed by the guard; stale DNS grants expire automatically.
    set cert_https4 {
        type ipv4_addr
        flags timeout
        timeout 1h
    }
    chain input {
        type filter hook input priority -150; policy drop;
        ct state invalid drop
        meta nfproto ipv6 drop
        ct state established,related accept
        iifname "lo" ip saddr 127.0.0.1 accept
        ip saddr 100.64.0.0/10 tcp dport 9090 accept
        ip saddr 172.30.80.3 tcp dport 2019 accept
        ip saddr 100.64.0.0/10 tcp dport { 80, 443 } accept
    }
    chain forward {
        type filter hook forward priority -150; policy drop;
    }
    chain output {
        # Before Docker's OUTPUT DNS DNAT (-100): block 127.0.0.11 too.
        type filter hook output priority -150; policy drop;
        ct state invalid drop
        meta nfproto ipv6 drop
        ct state established,related accept
        oifname "lo" ip daddr 127.0.0.1 accept
        # ICPM HTTPS management frontend -> its own management app.
        ip daddr 172.30.80.3 tcp dport 3000 accept
        # Gateway relay to PCPM management only.
        ip daddr 172.30.80.4 tcp dport 3001 accept
        # DNS-01: recursive and authoritative DNS queries.
        udp dport 53 accept
        tcp dport 53 accept
        ip daddr @cert_https4 tcp dport 443 accept
        # Other management/host destinations stay blocked.
        ip daddr { 172.30.80.0/24, 172.30.81.0/24, 127.0.0.0/8, 169.254.0.0/16, @@PUBLIC_BIND_IP@@, @@HOST_TAILNET_IP@@ } drop
        ip daddr 100.64.0.0/10 meta l4proto tcp accept
    }
}
