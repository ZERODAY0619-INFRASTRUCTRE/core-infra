# Only this namespace owns tailscale0. No exit node or subnet router.
table inet cpm {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        # Internal HTTPS frontend only: no host port is published for this relay.
        ip saddr 172.30.80.2 ip daddr 172.30.80.4 tcp dport 3001 dnat ip to 172.30.81.3:3000
        iifname "tailscale0" fib daddr type local tcp dport 80 dnat ip to 172.30.80.2:80
        iifname "tailscale0" fib daddr type local tcp dport 443 dnat ip to 172.30.80.2:443
        iifname "tailscale0" fib daddr type local ip saddr 100.64.0.0/10 tcp dport 3000 dnat ip to 172.30.80.3:3000
        iifname "tailscale0" fib daddr type local ip saddr 100.64.0.0/10 tcp dport 3001 dnat ip to 172.30.81.3:3000
        iifname "tailscale0" fib daddr type local ip saddr 100.64.0.0/10 tcp dport 9090 dnat ip to 172.30.80.2:9090
        iifname "tailscale0" fib daddr type local ip saddr 100.64.0.0/10 tcp dport 9091 dnat ip to 172.30.81.2:9090
    }
    chain input {
        type filter hook input priority -150; policy drop;
        ct state invalid drop
        iifname "lo" accept
        meta nfproto ipv6 drop
        ct state established,related accept
        iifname "tailscale0" drop
        ip saddr { 172.30.80.0/24, 172.30.81.0/24 } drop
        udp dport 41641 accept
    }
    chain forward {
        type filter hook forward priority -150; policy drop;
        ct state invalid drop
        meta nfproto ipv6 drop
        ct state established,related accept
        iifname "tailscale0" ct status dnat ip saddr 100.64.0.0/10 ip daddr 172.30.80.2 tcp dport { 80, 443 } accept
        iifname "tailscale0" ct status dnat ip saddr 100.64.0.0/10 ip daddr { 172.30.80.3, 172.30.81.3 } tcp dport 3000 accept
        # Narrow cross-bridge management relay; all other crossings stay denied.
        ct status dnat ip saddr 172.30.80.2 ip daddr 172.30.81.3 tcp dport 3000 accept
        # Per-Caddy guards enforce destination boundaries first.
        iifname != "tailscale0" ip saddr { 172.30.80.2, 172.30.81.2 } oifname "tailscale0" ip daddr 100.64.0.0/10 meta l4proto tcp accept
        iifname "tailscale0" ct status dnat ip saddr 100.64.0.0/10 ip daddr { 172.30.80.2, 172.30.81.2 } tcp dport 9090 accept
    }
    chain output {
        type filter hook output priority -150; policy accept;
        # Tailscale needs control-plane, DNS, DERP and peer transport.
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr 172.30.80.2 ip daddr 172.30.81.3 tcp dport 3000 snat ip to 172.30.81.4
        # SNAT backend requests; preserve incoming client IP.
        oifname "tailscale0" ip saddr { 172.30.80.2, 172.30.81.2 } masquerade
    }
}
